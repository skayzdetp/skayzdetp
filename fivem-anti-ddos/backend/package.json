{
  "name": "fxshield-backend",
  "version": "1.0.0",
  "private": true,
  "description": "FX Shield backend: API for the FiveM resource + dashboard host",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "workspaces": [
    "dashboard"
  ],
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "dev:dashboard": "npm run dev --workspace fxshield-dashboard",
    "build": "npm run build:dashboard && npm run build:server",
    "build:server": "tsc -p tsconfig.build.json",
    "build:dashboard": "npm run build --workspace fxshield-dashboard",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit && npm run typecheck --workspace fxshield-dashboard",
    "test": "vitest run",
    "gen:lua-schema": "tsx scripts/gen-lua-schema.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/helmet": "^13.1.1",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/static": "^10.1.5",
    "fastify": "^5.12.5",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
