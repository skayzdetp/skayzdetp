# ───────────────────────────────────────────────────────────────
#  FX Shield backend – configuration
#  Copy this file to ".env" and adjust. Every value is optional.
# ───────────────────────────────────────────────────────────────

# Address / port the HTTP server listens on
HOST=0.0.0.0
PORT=8080

# SQLite database file (the folder is created automatically)
DATABASE_PATH=./data/fxshield.db

# Public URL of this backend, e.g. https://shield.example.com
# Used for secure cookies and for the Origin check of the dashboard API.
PUBLIC_URL=

# Set to "true" when the backend runs behind a reverse proxy (nginx, Caddy,
# Cloudflare, …) so the real client IP is taken from X-Forwarded-For.
TRUST_PROXY=false

# Cookie "Secure" flag: auto (= on when PUBLIC_URL is https), true or false
COOKIE_SECURE=auto

# Dashboard session lifetime in hours
SESSION_TTL_HOURS=168

# How long security events / statistics are kept
EVENT_RETENTION_DAYS=14
STATS_RETENTION_DAYS=30

# Max. sync requests per minute and API key (the resource syncs ~6x per minute)
AGENT_RATE_LIMIT_PER_MIN=60

# Optional: fixed one-time setup token for creating the first admin account.
# If empty, a random token is printed to the log on first start.
SETUP_TOKEN=

# trace | debug | info | warn | error
LOG_LEVEL=info
